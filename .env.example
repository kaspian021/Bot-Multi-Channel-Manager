# ==============================================================
# AI Multi-Channel Telegram Manager — Environment Configuration
# ==============================================================

# Core Mode
DEMO_MODE=true
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000

# Database
# If DATABASE_CONNECTION_STRING is blank, embedded PostgreSQL (PGlite) with persistence is used.
DATABASE_CONNECTION_STRING=
# Or for external PostgreSQL: postgresql://postgres:postgres@localhost:5432/aichannelmanager
REDIS_CONNECTION_STRING=

# Telegram Integration
# Numeric ID of Telegram Owner (never rely on username alone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=987654321
TELEGRAM_MODE=polling
WEBHOOK_SECRET=

# AI Provider Configuration
# Supported: openai, gemini, mock
AI_PROVIDER=openai
RESEARCH_PROVIDER=google
IMAGE_PROVIDER=openai

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini API
GOOGLE_AI_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# External Research Connectors
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Operational & Safety Controls
PAUSE_PUBLISHING=false
RESEARCH_INTERVAL_HOURS=3
DAILY_POST_TARGET=3
DUPLICATE_SIMILARITY_THRESHOLD=0.75
MIN_CONTENT_SCORE=75
