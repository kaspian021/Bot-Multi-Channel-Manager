# ==============================================================
# AI Multi-Channel Telegram Manager — Environment Configuration
# ==============================================================

# Core Mode
DEMO_MODE=true
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000

# Database
# If DATABASE_CONNECTION_STRING is blank, embedded PostgreSQL (PGlite) with persistence is used.
DATABASE_CONNECTION_STRING=
# Or for external PostgreSQL: postgresql://postgres:postgres@localhost:5432/aichannelmanager
REDIS_CONNECTION_STRING=

# Telegram Integration
# Production identity is linked per account/workspace. TELEGRAM_OWNER_USER_ID is
# a DEMO_MODE-only fallback for legacy simulator fixtures; never use it as a
# production authorization boundary.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OWNER_USER_ID=987654321
TELEGRAM_MODE=polling
WEBHOOK_SECRET=

# Phase 4 commercial integration seam (no payment gateway is implemented)
PRODUCT_KEY=ai-channel-manager
ENTITLEMENT_PROVIDER=mock
ENTITLEMENT_CACHE_TTL_SECONDS=60
PLATFORM_MIN_GENERATION_INTERVAL_SECONDS=300
ACCOUNT_LINK_TOKEN_TTL_SECONDS=600
INTEGRATION_API_BASE_URL=
INTEGRATION_API_KEY=
INTEGRATION_WEBHOOK_SECRET=
WORKER_CHANNELS_PER_TICK=10
DEMO_ACCOUNT_ID=acc-demo-001
DEMO_WORKSPACE_ID=ws-demo-001

# AI Provider Configuration
# Supported: openai, gemini, mock
AI_PROVIDER=openai
RESEARCH_PROVIDER=google
IMAGE_PROVIDER=openai

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini API
GOOGLE_AI_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# External Research Connectors
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Operational & Safety Controls
PAUSE_PUBLISHING=false
RESEARCH_INTERVAL_HOURS=3
DAILY_POST_TARGET=3
DUPLICATE_SIMILARITY_THRESHOLD=0.75
MIN_CONTENT_SCORE=75
